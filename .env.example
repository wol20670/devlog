# DevLog 환경변수 예시 — 실제 값은 .env.local (Git 미추적) 또는 Vercel 환경변수에만 둔다.

# Neon PostgreSQL 연결 문자열
# 로컬/Preview: Neon `dev` 브랜치, Production: Neon `main` 브랜치
DATABASE_URL=

# Better Auth 세션 서명·OAuth 토큰 암호화 키 (32바이트 이상 랜덤 값, 환경마다 다르게)
BETTER_AUTH_SECRET=

# 앱의 기준 URL (로컬: http://localhost:3000, 운영: https://<prod-domain>)
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (로컬용과 운영용을 따로 생성)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
